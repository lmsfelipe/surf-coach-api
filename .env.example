APP_ENV=development
PORT=8000
LOG_LEVEL=INFO

# Async SQLAlchemy DSN — points at the local docker `db` service in dev.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/postgres

# Supabase project — fill these in from Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Phase 2 additions
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
FRAME_EXTRACT_COUNT=6
# Gemini content moderation at upload time. Disabled for the controlled release
# (each call added tens of seconds per file). Re-enable when a faster approach lands.
CONTENT_MODERATION_ENABLED=false
MAX_UPLOAD_SIZE_MB=40
# Parts accepted per multipart upload, counted regardless of type. The whole
# request body is capped at MAX_UPLOAD_FILES * MAX_UPLOAD_SIZE_MB (+1 MiB).
MAX_UPLOAD_FILES=10
MAX_VIDEO_DURATION_SEC=40
TRAINING_WORKOUTS_PER_PLAN=3
SUPABASE_BUCKET=surf-media
# Video optimization (background transcode). Keep disabled until you have verified
# the worker container has enough memory headroom for a transcode.
VIDEO_OPTIMIZE_ENABLED=false
# Max simultaneous ffmpeg transcodes. ffmpeg is memory-heavy; >1 on a small
# container OOM-kills it ("ffmpeg exited -9"). Independent of WORKER_MAX_JOBS.
VIDEO_OPTIMIZE_CONCURRENCY=1
# Give up on a video after this many failed transcodes so a corrupt/oversized
# file is not re-enqueued forever.
VIDEO_OPTIMIZE_MAX_ATTEMPTS=3
STUCK_JOB_THRESHOLD_SEC=300

# Async processing (arq worker)
REDIS_URL=redis://redis:6379
WORKER_MAX_JOBS=10
WORKER_JOB_TIMEOUT_SEC=300

# Production networking (ignored in development, where all hosts/origins are allowed).
# JSON arrays. CORS_ORIGINS = frontend origins; ALLOWED_HOSTS = permitted Host headers
# (empty = allow all). When ALLOWED_HOSTS is set on Railway, include the platform
# health-check host or the deploy never goes healthy.
CORS_ORIGINS=["localhost:5173"]
ALLOWED_HOSTS=[""]
