APP_ENV=development
PORT=8000
LOG_LEVEL=INFO

# Async SQLAlchemy DSN — points at the local docker `db` service in dev.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/postgres
# Per-process SQLAlchemy pool. Supabase's session-mode pooler caps all clients at
# its pool size (15 by default) — see DEPLOY.md §5. One process now serves HTTP and
# jobs, so keep JOBS_MAX_CONCURRENT + concurrent HTTP DB use within DB_POOL_SIZE.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SEC=10

# Supabase project — fill these in from Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Phase 2 additions
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
# Single Gemini call (media + description) instead of the two-pass media-then-refine
# flow. Keep OFF until score-bias validation confirms the description does not move
# the scores. When on, GEMINI_TEMPERATURE controls score stability.
SINGLE_PASS_REVIEW=false
GEMINI_TEMPERATURE=0.2
# Retry transient Gemini failures (503 overloads, dropped keep-alive connections)
# with exponential backoff. GEMINI_MAX_ATTEMPTS=1 disables retries.
GEMINI_MAX_ATTEMPTS=3
GEMINI_RETRY_BASE_DELAY_SEC=0.5
# Thinking level for Gemini 3.x calls (MINIMAL|LOW|MEDIUM|HIGH). 3.x models think
# at MEDIUM by default — LOW cuts review latency for structured scoring. Leave
# EMPTY for 2.x models (they reject thinking_level).
GEMINI_THINKING_LEVEL=LOW
FRAME_EXTRACT_COUNT=6
# Gemini content moderation at upload time. Disabled for the controlled release
# (each call added tens of seconds per file). Re-enable when a faster approach lands.
CONTENT_MODERATION_ENABLED=false
MAX_UPLOAD_SIZE_MB=40
# Parts accepted per multipart upload, counted regardless of type. The whole
# request body is capped at MAX_UPLOAD_FILES * MAX_UPLOAD_SIZE_MB (+1 MiB).
# Keep it at or above MAX_UPLOAD_PHOTOS + MAX_UPLOAD_VIDEOS, or a batch that
# satisfies the photo/video caps is still rejected on part count.
MAX_UPLOAD_FILES=11
# Photo/video counts per upload. MIN_UPLOAD_PHOTOS applies only when the upload contains
# at least one photo (a video-only upload is unaffected) and must not exceed
# MAX_UPLOAD_PHOTOS — the app refuses to start otherwise. At least one photo per review,
# and at most ten, is the current product rule.
MIN_UPLOAD_PHOTOS=1
MAX_UPLOAD_PHOTOS=10
MAX_UPLOAD_VIDEOS=1
MAX_VIDEO_DURATION_SEC=40
TRAINING_WORKOUTS_PER_PLAN=3
SUPABASE_BUCKET=surf-media
# Background jobs run inside the API process — no worker service, no Redis.
# Each running review holds the video bytes and extracted frames in memory, so
# keep JOBS_MAX_CONCURRENT low and within DB_POOL_SIZE alongside HTTP traffic.
JOBS_MAX_CONCURRENT=2
# Jobs allowed to wait for a slot. Past this, a submit is rejected straight away
# and the row reads "busy, try again" instead of "took too long" 4 minutes later.
JOBS_MAX_QUEUED=4
# JOB_TIMEOUT_SEC is the total budget from submit (wait for a slot + run), and
# JOB_MAX_WAIT_SEC caps the wait part, so a job that starts always has
# JOB_TIMEOUT_SEC - JOB_MAX_WAIT_SEC left to run. Must stay below
# STUCK_JOB_THRESHOLD_SEC.
JOB_MAX_WAIT_SEC=60
JOB_TIMEOUT_SEC=240
# How long a redeploy waits for running jobs before cancelling them. Railway's
# RAILWAY_DEPLOYMENT_DRAINING_SECONDS must exceed this by ~5 s.
JOB_SHUTDOWN_GRACE_SEC=25
STUCK_JOB_THRESHOLD_SEC=300

# Gemini timeouts. A thread cannot be cancelled, so without these a hung call
# would outlive the job that started it inside the API process.
GEMINI_REQUEST_TIMEOUT_SEC=90
GEMINI_MIN_ATTEMPT_SEC=10
GEMINI_DEADLINE_MARGIN_SEC=5

# Production networking (ignored in development, where all hosts/origins are allowed).
# JSON arrays. CORS_ORIGINS = frontend origins; ALLOWED_HOSTS = permitted Host headers
# (empty = allow all). When ALLOWED_HOSTS is set on Railway, include the platform
# health-check host or the deploy never goes healthy.
CORS_ORIGINS=["localhost:5173"]
ALLOWED_HOSTS=[""]
