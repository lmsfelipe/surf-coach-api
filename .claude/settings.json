{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(docker compose:*)",
      "Bash(docker exec:*)",
      "Bash(docker --version)",
      "Bash(alembic:*)",
      "Bash(uvicorn:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(pip show:*)",
      "Bash(pip3 show:*)",
      "Bash(pip list:*)",
      "Bash(pip3 list:*)",
      "Bash(python -m compileall:*)",
      "Bash(python3 -m compileall:*)",
      "Bash(python3 -c:*)",
      "Bash(curl -s http://localhost:*)"
    ]
  }
}
